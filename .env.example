# Model configuration
UNET_MODEL_PATH=backend/unet_finetuned_v2.pth
ALLOW_UNTRAINED_MODEL=0

# CORS configuration (comma-separated list of allowed origins)
# For Railway/Vercel, typically set to your frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Platform detection (set automatically by platform)
# VERCEL=1          # Set by Vercel automatically
# RAILWAY=1         # Set by Railway automatically
