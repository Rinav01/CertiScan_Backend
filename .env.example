# Model configuration
UNET_MODEL_PATH=backend/unet_finetuned_v2.pth
ALLOW_UNTRAINED_MODEL=0

# CORS configuration (comma-separated list of allowed origins)
# For Railway, typically set to your frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: override these if deploying with custom settings
# RAILWAY sets PORT automatically, so these are usually not needed
# PORT=8000
# HOST=0.0.0.0
