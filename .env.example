# ── Model configuration ──────────────────────────────────────────────────────
# Path to the U-Net weights file, relative to the project root.
# For Railway, this path is relative inside the Docker container (/app/).
UNET_MODEL_PATH=backend/unet_finetuned_v2.pth

# Set to 1 to allow startup without trained weights (dev/testing only).
ALLOW_UNTRAINED_MODEL=0

# ── CORS configuration ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Replace with your actual frontend URL(s) on Railway / Vercel / etc.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Railway (set automatically by platform, no action needed) ─────────────────
# PORT=8000          # Railway injects $PORT automatically
# RAILWAY_ENVIRONMENT=production
